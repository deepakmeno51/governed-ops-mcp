POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ops
POSTGRES_PORT=5432
# Use letters and digits only in passwords
AGENT_RO_PASSWORD=change_me_ro
AGENT_RW_PASSWORD=change_me_rw
AUDIT_WRITER_PASSWORD=change_me_audit
OPS_EXECUTOR_PASSWORD=change_me_exec
APPROVAL_DECIDER_PASSWORD=change_me_decider
# Optional. Dev tokens are built in. Format: token:actor:role,token:actor:role (roles: operator, viewer)
# MCP_API_TOKENS=dev-operator-token:alice:operator,dev-viewer-token:bob:viewer
# Optional. Approval UI logins (name:password,...) and approval lifetime in minutes.
# APPROVERS=carol:dev-approver-pass,alice:dev-alice-pass
# APPROVAL_TTL_MINUTES=10
# Optional. Limits for the MCP server (seconds). Tier 1 and 2 tool calls stop waiting after TOOL_TIMEOUT_SECONDS.
# An execution stuck longer than EXECUTION_STALE_SECONDS is closed as failed. The expiry job runs every MAINTENANCE_INTERVAL_SECONDS.
# TOOL_TIMEOUT_SECONDS=30
# EXECUTION_STALE_SECONDS=120
# MAINTENANCE_INTERVAL_SECONDS=30
